    },
    {
      "name": "CPI +100",
      "title": "Increase trackball CPI by 100",
      "shortName": "CPI +100"
    },
    {
      "name": "CPI -100",
      "title": "Decrease trackball CPI by 100",
      "shortName": "CPI -100"
    },
    {
      "name": "CPI +1000",
      "title": "Increase trackball CPI by 1000",
      "shortName": "CPI +1K"
    },
    {
      "name": "CPI -1000",
      "title": "Decrease trackball CPI by 1000",
      "shortName": "CPI -1K"
    },
    {
      "name": "Scroll Toggle",
      "title": "Toggle trackball scroll mode on/off",
      "shortName": "SCRL TO"
    },
    {
      "name": "Scroll Hold",
      "title": "Hold this key to use the trackball as a scroll wheel; release to return to pointer mode",
      "shortName": "SCRL MO"
    },
    {
      "name": "Scroll Slower",
      "title": "Increase scroll divider (slower scrolling)",
      "shortName": "SCRL DVI"
    },
    {
      "name": "Scroll Faster",
      "title": "Decrease scroll divider (faster scrolling)",
      "shortName": "SCRL DVD"
    },
    {
      "name": "Auto Mouse Toggle",
      "title": "Toggle Keyball automatic mouse layer",
      "shortName": "AML TO"
    },
    {
      "name": "Auto Mouse +50ms",
      "title": "Increase automatic mouse layer timeout by 50 ms",
      "shortName": "AML I50"
    },
    {
      "name": "Auto Mouse -50ms",
      "title": "Decrease automatic mouse layer timeout by 50 ms",
      "shortName": "AML D50"
    },
    {
      "name": "Scroll Snap Vertical",
      "title": "Set scroll snap mode to vertical",
      "shortName": "SSNP VRT"
    },
    {
      "name": "Scroll Snap Horizontal",
      "title": "Set scroll snap mode to horizontal",
      "shortName": "SSNP HOR"
    },
    {
      "name": "Scroll Snap Free",
      "title": "Disable scroll snapping / free scroll",
      "shortName": "SSNP FRE"
    },
    {
      "name": "Mouse Layer Timeout",
      "title": "Cycle trackball mouse-layer timeout: 0s, 0.5s, 1s, 5s, 10s, never",
      "shortName": "AML TIME"
    }
  ]
